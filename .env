# --- App ---
PROJECT_NAME="AI Research Assistant"
ENVIRONMENT=local
DEBUG=true

# --- Database ---
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=npg_V81FgHvOcGfd
POSTGRES_HOST=ep-sweet-king-ayriepcp.c-5.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_SSLMODE=require
# Optional — overrides the assembled URL above if set
# DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/research_assistant

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis --- (removed from the app)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# USE_REDIS=false
# REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-random-32-char-minimum-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Celery --- (removed — document processing runs inline in the API)
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- File storage / uploads ---
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=["pdf","docx","txt","png","jpg","jpeg"]

# --- OCR / chunking ---
OCR_LANGUAGES=["en"]
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
